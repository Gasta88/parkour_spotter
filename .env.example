# PostgreSQL Configuration
POSTGRES_USER=parkour
POSTGRES_PASSWORD=changeme
POSTGRES_DB=parkour
POSTGRES_PORT=5432

# Database URL (constructed from above)
DATABASE_URL=postgresql+asyncpg://parkour:changeme@postgis:5432/parkour

# H3 Configuration
H3_RESOLUTION=11

# OSM Data Source (Padova bbbike.org URL)
OSM_URL=https://download.bbbike.org/osm/bbbike/Padova/Padova.osm.pbf

# Local OSM File (optional — set to a filename inside /osm-data, e.g. city.osm.pbf)
# When set, the loader uses this local file instead of downloading from OSM_URL.
# Place the .osm.pbf file in the data/ directory at the project root.
# OSM_LOCAL_FILE=city.osm.pbf

# OSM Loader Configuration
OSM_MIN_FILE_SIZE_MB=1
REFRESH_INTERVAL_HOURS=24
FORCE_RELOAD=false
OSM2PGSQL_CACHE_MB=512
OSM2PGSQL_PROCESSES=2

# Service Ports
API_PORT=8000
ANNOTATOR_PORT=8001
FRONTEND_PORT=8080
