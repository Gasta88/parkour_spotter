# PostgreSQL Configuration
POSTGRES_USER=parkour
POSTGRES_PASSWORD=changeme
POSTGRES_DB=parkour
POSTGRES_PORT=5432

# Database URL (constructed from above)
DATABASE_URL=postgresql+asyncpg://parkour:changeme@postgis:5432/parkour

# H3 Configuration
H3_RESOLUTION=11

# OSM Data Source (REQUIRED)
# Place your .osm.pbf file in the data/ directory at the project root.
# Then set OSM_LOCAL_FILE to the filename (e.g., city.osm.pbf)
OSM_LOCAL_FILE=city.osm.pbf

# OSM Loader Configuration
OSM_MIN_FILE_SIZE_MB=1
REFRESH_INTERVAL_HOURS=24
FORCE_RELOAD=false
OSM2PGSQL_CACHE_MB=512
OSM2PGSQL_PROCESSES=2

# Service Ports
API_PORT=8000
ANNOTATOR_PORT=8001
FRONTEND_PORT=8080
